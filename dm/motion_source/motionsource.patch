+
+- (void)updateServerButton {
+    UIButtonConfiguration *configuration = [_startstopServerButton.configuration copy];
+    configuration.title = wantsServer ? @"Stop Server" : @"Start Server";
+    configuration.baseForegroundColor = wantsServer ? UIColor.systemRedColor : UIColor.systemGreenColor;
+    _startstopServerButton.configuration = configuration;
+    _startstopServerButton.enabled = YES;
+}
+
+- (void)releaseServer {
+    serverGeneration++;
+    [retryTimer invalidate]; retryTimer = nil;
+    GCDAsyncUdpSocket *closing = socket;
+    socket = nil;
+    closing.delegate = nil;
+    [closing close];
+    [self stopGyroUpdates];
+    [self updateLastAddress:nil];
+    serverStarted = NO;
+    hasSentMotion = NO;
+    UIApplication.sharedApplication.idleTimerDisabled = NO;
+}
+
+- (void)retryServer {
+    if (!wantsServer || UIApplication.sharedApplication.applicationState != UIApplicationStateActive) return;
+    NSUInteger generation = serverGeneration;
+    __weak ViewController *weakSelf = self;
+    retryTimer = [NSTimer scheduledTimerWithTimeInterval:2 repeats:NO block:^(NSTimer *timer) {
+        (void)timer;
+        ViewController *self = weakSelf;
+        if (self && self->wantsServer && generation == self->serverGeneration &&
+            UIApplication.sharedApplication.applicationState == UIApplicationStateActive)
+            [self startServer];
+    }];
+}
+
+- (void)suspendServer:(NSNotification *)note {
+    (void)note;
+    if (!wantsServer) return;
+    [self releaseServer];
+    [self setStatus:@"Paused. Return to this app to resume on the same port."];
+}
+
+- (void)resumeServer:(NSNotification *)note {
+    (void)note;
+    _ipAddressLabel.text = [self getIPAddress];
+    if (wantsServer && !serverStarted) [self startServer];
+}
 
