# dm/host unit tests in one command: make -C dm/host/tests GAME=<base game title ID> run (takes seconds; build output goes to build/ and is not committed)
B = build
# game profile header (dm.h needs game_profile.h, generated by the host Makefile into ../gen/<profile>/)
# tests that use the game profile need GAME=<base game title ID> (there is no default game); GINC only expands when used, so tests without the profile build as before
GINC = $(if $(strip $(GAME)),-I../gen/$(GAME) -I../../games/$(GAME),$(error GAME is not set: make GAME=<base game title ID>: $(shell python3 ../../games/game.py list | awk -F'\t' '{printf "%s (%s)  ", $$1, $$3}')))
GAME_H = ../gen/$(GAME)/game_profile.h
run: $(B)/t_touch $(B)/t_oe $(B)/t_fs $(B)/t_fs_commit_list $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_audio_spsc $(B)/t_swkbd $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_pctl $(B)/t_time $(B)/t_shared_font $(B)/t_vorbis $(B)/t_vorbis_divides
	$(B)/t_touch
	$(B)/t_padmap
	$(B)/t_gamepad_mac
	$(B)/t_hid_axes_script
	$(B)/t_rumble_mac
	$(B)/t_motion_mac
	$(B)/t_motion_dsu
	$(B)/t_resolution_mac
	$(B)/t_timing_mac
	$(B)/t_cheats_mac
	$(B)/t_oe 2>/dev/null
	$(B)/t_fs 2>/dev/null
	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit_list
	$(B)/t_thread_leak
	TMPDIR="$(abspath $(B))" $(B)/t_fs_case 2>/dev/null
	$(B)/t_audio
	$(B)/t_audio_spsc
	$(B)/t_swkbd
	$(B)/t_altstack
	$(B)/t_condvar
	$(B)/t_condvar_old
	$(B)/t_pctl
	$(B)/t_time
	$(B)/t_shared_font
	$(B)/t_vorbis
	$(B)/t_vorbis_divides
$(GAME_H): ../../games/game.py ../../games/$(GAME)/game.tsv
	$(MAKE) -C .. game_profile GAME=$(GAME)
$(B)/t_touch: t_touch.c ../hle_touch.c ../front.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_touch.c ../hle_touch.c
$(B)/t_thread_leak: t_thread_leak.c ../thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_thread_leak.c
$(B)/t_fs: t_fs.c t_fs_stub.c ../hle_fs.c ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_fs.c t_fs_stub.c ../hle_bigstack.c
$(B)/t_fs_commit_list: t_fs_commit_list.c t_fs_stub.c ../hle_fs.c ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Wno-unused-function -I.. $(GINC) -o $@ t_fs_commit_list.c t_fs_stub.c ../hle_bigstack.c
$(B)/t_fs_case: t_fs_case.c ../hle_fs.c ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_fs_case.c ../hle_bigstack.c
$(B)/t_audio: t_audio.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_audio.c -framework AudioToolbox
$(B)/t_audio_spsc: t_audio_spsc.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_audio_spsc.c -framework AudioToolbox
$(B)/t_audio_spsc_tsan: t_audio_spsc.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -g -O1 -fsanitize=thread -Wno-unused-function -I.. $(GINC) -o $@ t_audio_spsc.c -framework AudioToolbox
$(B)/t_swkbd: t_swkbd.c ../hle_swkbd.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_swkbd.c ../hle_swkbd.c
$(B)/t_altstack: t_altstack.c t_altstack_stub.c ../crash.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_altstack.c t_altstack_stub.c ../crash.c
$(B)/t_pctl: t_pctl.c ../hle_misc.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_pctl.c
$(B)/t_shared_font: t_shared_font.c ../hle_sdk16.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -Wno-frame-address -I.. $(GINC) -o $@ t_shared_font.c
$(B)/t_time: t_time.c ../hle_time.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_time.c
$(B)/t_oe: t_oe.c ../hle_oe.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_oe.c
$(B)/t_condvar: t_condvar.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -DDM_TEST_HOOKS -I.. $(GINC) -o $@ t_condvar.c t_condvar_stub.c ../hle_thread.c
$(B)/t_condvar_old: t_condvar.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -DDM_TEST_HOOKS -DDM_TEST_CV_OLD_ORDER -I.. $(GINC) -o $@ t_condvar.c t_condvar_stub.c ../hle_thread.c
# the Vorbis tests build their own packets and need no game profile (they build without GAME)
$(B)/t_vorbis: t_vorbis.c ../../third_party/stb_vorbis/stb_vorbis.c | $(B)
	clang -O1 -g -Wno-unused-function -Wno-tautological-compare -o $@ t_vorbis.c
$(B)/t_vorbis_divides: t_vorbis.c ../../third_party/stb_vorbis/stb_vorbis.c | $(B)
	clang -O1 -g -DSTB_VORBIS_DIVIDES_IN_RESIDUE -Wno-unused-function -Wno-tautological-compare -o $@ t_vorbis.c
$(B):
	mkdir -p $@
.PHONY: run tsan
run: $(B)/t_cheats_mac

$(B)/t_cheats_mac: t_cheats_mac.c ../cheats_mac.c ../cheats_mac.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_cheats_mac.c

run-cheats: $(B)/t_cheats_mac
	$(B)/t_cheats_mac

.PHONY: run-cheats
tsan: $(B)/t_audio_spsc_tsan
	$(B)/t_audio_spsc_tsan

run: $(B)/t_padmap $(B)/t_gamepad_mac $(B)/t_hid_axes_script $(B)/t_rumble_mac $(B)/t_motion_mac $(B)/t_motion_dsu $(B)/t_resolution_mac $(B)/t_timing_mac

run-mac-input: $(B)/t_padmap $(B)/t_gamepad_mac $(B)/t_hid_axes_script $(B)/t_rumble_mac $(B)/t_motion_mac $(B)/t_motion_dsu $(B)/t_resolution_mac $(B)/t_timing_mac
	$(B)/t_padmap
	$(B)/t_gamepad_mac
	$(B)/t_hid_axes_script
	$(B)/t_rumble_mac
	$(B)/t_motion_mac
	$(B)/t_motion_dsu
	$(B)/t_resolution_mac
	$(B)/t_timing_mac

$(B)/t_padmap: t_padmap.c ../dm_padmap.h ../dm_input.h | $(B)
	clang -O1 -Wall -Werror -o $@ t_padmap.c
$(B)/t_gamepad_mac: t_gamepad_mac.m ../gamepad_mac.m ../gamepad_mac.h ../motion_controller_mac.m ../motion_controller_mac.h ../motion_filter_mac.h ../rumble_mac.m ../rumble_mac.h ../input_focus_mac.m ../input_focus_mac.h ../dm_padmap.h ../dm_input.h ../hle_hid.c ../hle.h ../dm.h ../hle_touch.c hid_test_clock.c $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -fobjc-arc $(GINC) -I.. -o $@ ../hle_touch.c hid_test_clock.c t_gamepad_mac.m ../rumble_mac.m ../motion_controller_mac.m -framework Cocoa -framework GameController -framework CoreHaptics
$(B)/t_hid_axes_script: t_hid_axes_script.c ../hle_hid.c ../hle.h ../dm.h ../dm_input.h ../hle_touch.c hid_test_clock.c | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function $(GINC) -I.. -o $@ ../hle_touch.c hid_test_clock.c t_hid_axes_script.c
$(B)/t_rumble_mac: t_rumble_mac.m ../rumble_mac.m ../rumble_mac.h ../hle_hid.c ../hle.h ../dm.h ../dm_input.h ../hle_touch.c hid_test_clock.c $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -fobjc-arc $(GINC) -I.. -o $@ ../hle_touch.c hid_test_clock.c t_rumble_mac.m -framework Foundation -framework GameController -framework CoreHaptics
$(B)/t_motion_dsu: t_motion_dsu.c ../motion_dsu_mac.c ../motion_dsu_mac.h ../motion_filter_mac.h ../hle_hid.c ../hle.h ../dm.h ../dm_input.h ../hle_touch.c hid_test_clock.c | $(B)
	clang -O2 -Wall -Wextra -Werror -Wno-unused-function -Wno-missing-field-initializers $(GINC) -I.. -o $@ ../hle_touch.c hid_test_clock.c t_motion_dsu.c
$(B)/t_resolution_mac: t_resolution_mac.c ../resolution_mac.c ../resolution_mac.h ../dm.h ../gen/$(GAME)/game_profile.h | $(B)
	clang -O2 -Wall -Werror $(GINC) -I.. -o $@ t_resolution_mac.c
$(B)/t_timing_mac: t_timing_mac.c ../timing_mac.c ../timing_mac.h ../dm.h ../gen/$(GAME)/game_profile.h | $(B)
	clang -O2 -Wall -Wextra -Werror -Wno-unused-function $(GINC) -I.. -o $@ t_timing_mac.c

$(B)/t_motion_mac: t_motion_mac.m ../motion_controller_mac.m ../motion_controller_mac.h ../motion_filter_mac.h ../motion_mac.m ../motion_dsu_mac.c ../motion_dsu_mac.h ../gamepad_mac.m ../rumble_mac.m ../hle_hid.c ../dm_input.h ../hle_touch.c hid_test_clock.c $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -fobjc-arc $(GINC) -I.. -o $@ ../hle_touch.c hid_test_clock.c t_motion_mac.m ../rumble_mac.m -framework Cocoa -framework GameController -framework CoreHaptics
